<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="com.teach.javafx.controller.StatisticsController" styleClass="statistics-root" stylesheets="@css/personal-center.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="6" styleClass="statistics-header">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label styleClass="statistics-title" text="数据统计分析" />
                    <Label styleClass="statistics-subtitle" text="聚合论坛运营、内容、互动与安全数据，便于快速判断趋势" />
                </VBox>
                <Label styleClass="statistics-header-badge" text="运营仪表盘" />
            </HBox>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="mainTabPane" prefHeight="800" prefWidth="1200" styleClass="statistics-tabs">
            <Tab closable="false" text="数据概览">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="statistics-scroll-pane">
                        <content>
                            <VBox spacing="18" styleClass="statistics-tab-content">
                                <Label styleClass="statistics-section-title" text="关键指标" />
                                <GridPane fx:id="overviewGrid" alignment="CENTER" hgap="16" styleClass="statistics-metric-grid" vgap="16">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="250" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="250" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="250" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="250" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="112" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="112" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                </GridPane>

                                <HBox alignment="CENTER_LEFT" styleClass="statistics-section-row">
                                    <Label styleClass="statistics-section-title" text="快速趋势" />
                                    <Label styleClass="statistics-section-note" text="近 7 日核心变化" />
                                </HBox>
                                <GridPane alignment="CENTER" hgap="16" vgap="16">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="320" vgrow="ALWAYS" />
                                    </rowConstraints>
                                    <VBox spacing="10" styleClass="statistics-chart-card" GridPane.columnIndex="0">
                                        <Label styleClass="statistics-card-title" text="近7日发帖趋势" />
                                        <LineChart fx:id="quickPostTrendChart" animated="false" legendVisible="false" prefHeight="280" styleClass="statistics-chart" VBox.vgrow="ALWAYS">
                                            <xAxis>
                                                <CategoryAxis fx:id="quickPostXAxis" label="日期" />
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis fx:id="quickPostYAxis" label="发帖量" />
                                            </yAxis>
                                        </LineChart>
                                    </VBox>
                                    <VBox spacing="10" styleClass="statistics-chart-card" GridPane.columnIndex="1">
                                        <Label styleClass="statistics-card-title" text="近7日用户增长趋势" />
                                        <LineChart fx:id="quickUserTrendChart" animated="false" legendVisible="false" prefHeight="280" styleClass="statistics-chart" VBox.vgrow="ALWAYS">
                                            <xAxis>
                                                <CategoryAxis fx:id="quickUserXAxis" label="日期" />
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis fx:id="quickUserYAxis" label="新增用户" />
                                            </yAxis>
                                        </LineChart>
                                    </VBox>
                                </GridPane>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>

            <Tab closable="false" text="用户统计">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="statistics-scroll-pane">
                        <content>
                            <VBox spacing="18" styleClass="statistics-tab-content">
                                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="statistics-section-toolbar">
                                    <Label styleClass="statistics-section-title" text="用户增长趋势" HBox.hgrow="ALWAYS" />
                                    <ChoiceBox fx:id="userGrowthDaysChoice" prefWidth="110" styleClass="statistics-choice" />
                                    <Button fx:id="refreshUserBtn" mnemonicParsing="false" prefWidth="84" styleClass="primary-button statistics-refresh-button" text="刷新" />
                                </HBox>
                                <VBox spacing="10" styleClass="statistics-chart-card">
                                    <LineChart fx:id="userGrowthChart" animated="false" legendVisible="false" prefHeight="320" styleClass="statistics-chart">
                                        <xAxis>
                                            <CategoryAxis fx:id="userGrowthXAxis" label="日期" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="userGrowthYAxis" label="新增用户数" />
                                        </yAxis>
                                    </LineChart>
                                </VBox>

                                <GridPane alignment="CENTER" hgap="16" vgap="16">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="320" vgrow="ALWAYS" />
                                    </rowConstraints>
                                    <VBox spacing="10" styleClass="statistics-chart-card" GridPane.columnIndex="0">
                                        <Label styleClass="statistics-card-title" text="用户类型分布" />
                                        <PieChart fx:id="userTypeChart" animated="false" prefHeight="280" styleClass="statistics-chart" />
                                    </VBox>
                                    <VBox spacing="10" styleClass="statistics-chart-card" GridPane.columnIndex="1">
                                        <Label styleClass="statistics-card-title" text="用户活跃度分布" />
                                        <BarChart fx:id="userActivityChart" animated="false" prefHeight="280" styleClass="statistics-chart">
                                            <xAxis>
                                                <CategoryAxis label="发帖数区间" />
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis label="用户数" />
                                            </yAxis>
                                        </BarChart>
                                    </VBox>
                                </GridPane>

                                <VBox spacing="12" styleClass="statistics-table-card">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label styleClass="statistics-section-title" text="活跃用户排行榜 (Top 20)" HBox.hgrow="ALWAYS" />
                                        <ChoiceBox fx:id="activeUserSortChoice" prefWidth="130" styleClass="statistics-choice" />
                                    </HBox>
                                    <TableView fx:id="activeUserTableView" prefHeight="280" styleClass="stats-table">
                                        <columns>
                                            <TableColumn fx:id="activeUserRankCol" prefWidth="60" text="排名" />
                                            <TableColumn fx:id="activeUserNicknameCol" prefWidth="150" text="昵称" />
                                            <TableColumn fx:id="activeUserStudentIdCol" prefWidth="120" text="学号/工号" />
                                            <TableColumn fx:id="activeUserTypeCol" prefWidth="80" text="角色" />
                                            <TableColumn fx:id="activeUserPostCol" prefWidth="80" text="发帖数" />
                                            <TableColumn fx:id="activeUserCommentCol" prefWidth="80" text="评论数" />
                                            <TableColumn fx:id="activeUserLikeCol" prefWidth="80" text="获赞数" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>

            <Tab closable="false" text="内容统计">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="statistics-scroll-pane">
                        <content>
                            <VBox spacing="18" styleClass="statistics-tab-content">
                                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="statistics-section-toolbar">
                                    <Label styleClass="statistics-section-title" text="发帖趋势" HBox.hgrow="ALWAYS" />
                                    <ChoiceBox fx:id="postTrendDaysChoice" prefWidth="110" styleClass="statistics-choice" />
                                    <Button fx:id="refreshContentBtn" mnemonicParsing="false" prefWidth="84" styleClass="primary-button statistics-refresh-button" text="刷新" />
                                </HBox>
                                <VBox spacing="10" styleClass="statistics-chart-card">
                                    <LineChart fx:id="postTrendChart" animated="false" legendVisible="false" prefHeight="320" styleClass="statistics-chart">
                                        <xAxis>
                                            <CategoryAxis fx:id="postTrendXAxis" label="日期" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="postTrendYAxis" label="发帖量" />
                                        </yAxis>
                                    </LineChart>
                                </VBox>

                                <GridPane alignment="CENTER" hgap="16" vgap="16">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="320" vgrow="ALWAYS" />
                                    </rowConstraints>
                                    <VBox spacing="10" styleClass="statistics-chart-card" GridPane.columnIndex="0">
                                        <Label styleClass="statistics-card-title" text="板块发帖分布" />
                                        <PieChart fx:id="boardDistributionChart" animated="false" prefHeight="280" styleClass="statistics-chart" />
                                    </VBox>
                                    <VBox spacing="10" styleClass="statistics-chart-card" GridPane.columnIndex="1">
                                        <Label styleClass="statistics-card-title" text="帖子状态分布" />
                                        <PieChart fx:id="postStatusChart" animated="false" prefHeight="280" styleClass="statistics-chart" />
                                    </VBox>
                                </GridPane>

                                <VBox spacing="12" styleClass="statistics-table-card">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label styleClass="statistics-section-title" text="热门帖子排行榜 (Top 20)" HBox.hgrow="ALWAYS" />
                                        <ChoiceBox fx:id="hotPostSortChoice" prefWidth="130" styleClass="statistics-choice" />
                                    </HBox>
                                    <TableView fx:id="hotPostTableView" prefHeight="280" styleClass="stats-table">
                                        <columns>
                                            <TableColumn fx:id="hotPostRankCol" prefWidth="60" text="排名" />
                                            <TableColumn fx:id="hotPostTitleCol" prefWidth="300" text="标题" />
                                            <TableColumn fx:id="hotPostBoardCol" prefWidth="100" text="板块" />
                                            <TableColumn fx:id="hotPostAuthorCol" prefWidth="100" text="作者" />
                                            <TableColumn fx:id="hotPostViewCol" prefWidth="70" text="浏览" />
                                            <TableColumn fx:id="hotPostLikeCol" prefWidth="70" text="点赞" />
                                            <TableColumn fx:id="hotPostCommentCol" prefWidth="70" text="评论" />
                                            <TableColumn fx:id="hotPostFavoriteCol" prefWidth="70" text="收藏" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>

            <Tab closable="false" text="互动统计">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="statistics-scroll-pane">
                        <content>
                            <VBox spacing="18" styleClass="statistics-tab-content">
                                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="statistics-section-toolbar">
                                    <Label styleClass="statistics-section-title" text="互动趋势" HBox.hgrow="ALWAYS" />
                                    <ChoiceBox fx:id="interactionDaysChoice" prefWidth="110" styleClass="statistics-choice" />
                                    <Button fx:id="refreshInteractionBtn" mnemonicParsing="false" prefWidth="84" styleClass="primary-button statistics-refresh-button" text="刷新" />
                                </HBox>
                                <GridPane alignment="CENTER" hgap="16" vgap="16">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="320" vgrow="ALWAYS" />
                                    </rowConstraints>
                                    <VBox spacing="10" styleClass="statistics-chart-card" GridPane.columnIndex="0">
                                        <Label styleClass="statistics-card-title" text="点赞趋势" />
                                        <LineChart fx:id="likeTrendChart" animated="false" legendVisible="false" prefHeight="280" styleClass="statistics-chart">
                                            <xAxis>
                                                <CategoryAxis label="日期" />
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis label="点赞数" />
                                            </yAxis>
                                        </LineChart>
                                    </VBox>
                                    <VBox spacing="10" styleClass="statistics-chart-card" GridPane.columnIndex="1">
                                        <Label styleClass="statistics-card-title" text="关注趋势" />
                                        <LineChart fx:id="followTrendChart" animated="false" legendVisible="false" prefHeight="280" styleClass="statistics-chart">
                                            <xAxis>
                                                <CategoryAxis label="日期" />
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis label="关注数" />
                                            </yAxis>
                                        </LineChart>
                                    </VBox>
                                </GridPane>

                                <VBox spacing="12" styleClass="statistics-table-card">
                                    <Label styleClass="statistics-section-title" text="热门评论排行" />
                                    <TableView fx:id="hotCommentTableView" prefHeight="280" styleClass="stats-table">
                                        <columns>
                                            <TableColumn fx:id="hotCommentRankCol" prefWidth="60" text="排名" />
                                            <TableColumn fx:id="hotCommentContentCol" prefWidth="400" text="评论内容" />
                                            <TableColumn fx:id="hotCommentAuthorCol" prefWidth="100" text="作者" />
                                            <TableColumn fx:id="hotCommentPostCol" prefWidth="200" text="所属帖子" />
                                            <TableColumn fx:id="hotCommentLikeCol" prefWidth="80" text="获赞数" />
                                            <TableColumn fx:id="hotCommentTimeCol" prefWidth="150" text="评论时间" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>

            <Tab closable="false" text="内容安全统计">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="statistics-scroll-pane">
                        <content>
                            <VBox spacing="18" styleClass="statistics-tab-content">
                                <Label styleClass="statistics-section-title" text="审核统计概览" />
                                <GridPane fx:id="moderationGrid" alignment="CENTER" hgap="16" styleClass="statistics-metric-grid" vgap="16">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="250" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="250" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="250" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="250" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="112" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                </GridPane>

                                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="statistics-section-toolbar">
                                    <Label styleClass="statistics-section-title" text="审核趋势" HBox.hgrow="ALWAYS" />
                                    <ChoiceBox fx:id="moderationDaysChoice" prefWidth="110" styleClass="statistics-choice" />
                                    <Button fx:id="refreshSafetyBtn" mnemonicParsing="false" prefWidth="84" styleClass="primary-button statistics-refresh-button" text="刷新" />
                                </HBox>
                                <VBox spacing="10" styleClass="statistics-chart-card">
                                    <LineChart fx:id="moderationTrendChart" animated="false" prefHeight="320" styleClass="statistics-chart">
                                        <xAxis>
                                            <CategoryAxis fx:id="moderationXAxis" label="日期" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="moderationYAxis" label="数量" />
                                        </yAxis>
                                    </LineChart>
                                </VBox>

                                <GridPane alignment="CENTER" hgap="16" vgap="16">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="330" vgrow="ALWAYS" />
                                    </rowConstraints>
                                    <VBox spacing="10" styleClass="statistics-chart-card" GridPane.columnIndex="0">
                                        <Label styleClass="statistics-card-title" text="违规类型分布" />
                                        <PieChart fx:id="violationTypeChart" animated="false" prefHeight="290" styleClass="statistics-chart" />
                                    </VBox>
                                    <VBox spacing="12" styleClass="statistics-chart-card" GridPane.columnIndex="1">
                                        <Label styleClass="statistics-card-title" text="举报统计" />
                                        <GridPane fx:id="reportStatsGrid" alignment="CENTER" hgap="14" vgap="14">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="200" />
                                                <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="200" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="106" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="106" vgrow="SOMETIMES" />
                                            </rowConstraints>
                                        </GridPane>
                                    </VBox>
                                </GridPane>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
