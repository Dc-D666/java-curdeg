<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>
<!-- 前端应用主框架FXML配置文件 对应页面交互控制类 com.teach.javafx.controller.base.MainFrameController -->
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TreeView?>
<BorderPane styleClass="app-shell" stylesheets="@../css/personal-center.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.base.MainFrameController">
  <top>
    <VBox>
      <children>
        <MenuBar fx:id="menuBar" styleClass="app-menu-bar">
          <menus>
            <Menu fx:id="menuHome" text="首页">
              <items>
                <MenuItem text="帖子广场" onAction="#onPostSquareClick" />
              </items>
            </Menu>
            <Menu fx:id="menuExportMenu" text="导出" visible="false">
              <items>
                <MenuItem text="导出帖子数据" onAction="#onExportPostsClick" />
                <MenuItem text="导出用户数据" onAction="#onExportUsersClick" />
                <MenuItem text="导出统计报表" onAction="#onExportStatsClick" />
              </items>
            </Menu>
            <Menu fx:id="menuSettings" text="设置">
            <items>
                <MenuItem text="系统设置" onAction="#onSystemSettingsClick" />
                <SeparatorMenuItem />
                <MenuItem fx:id="menuLogout" text="退出登录" onAction="#onLogoutMenuClick" />
            </items>
        </Menu>
            <Menu fx:id="menuHelp" text="帮助">
      <items>
        <MenuItem text="关于" onAction="#onAboutClick" />
        <MenuItem text="反馈与建议" onAction="#onFeedbackClick" />
        <MenuItem text="禁言申诉" onAction="#onBanAppealClick" />
      </items>
    </Menu>
            <Menu fx:id="menuSwitchAccount" text="切换账号" />
          </menus>
        </MenuBar>
        <HBox fx:id="bannedBanner" alignment="CENTER" managed="false" spacing="10.0" style="-fx-background-color: #fef2f2; -fx-border-color: #fecaca; -fx-border-width: 0 0 1 0; -fx-padding: 8 16 8 16;" visible="false">
          <children>
            <Label style="-fx-font-size: 14px; -fx-text-fill: #b91c1c; -fx-font-weight: bold;" text="⚠ 您已被禁言" />
            <Label fx:id="bannedBannerMessage" style="-fx-font-size: 13px; -fx-text-fill: #7f1d1d;" text="您的账号因违规行为已被管理员禁言，发帖、评论、点赞、收藏等互动功能已被限制。如有疑问，请联系管理员。" wrapText="true" HBox.hgrow="ALWAYS" />
          </children>
        </HBox>
      </children>
    </VBox>
  </top>
  <left>
    <TreeView fx:id="menuTree" prefWidth="210" styleClass="app-menu-tree"/>
  </left>
  <center>
    <StackPane BorderPane.alignment="CENTER">
      <children>
        <TabPane fx:id="contentTabPane" styleClass="app-content-tabs" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        </TabPane>
        <StackPane fx:id="emptyStatePane" pickOnBounds="false" styleClass="welcome-empty-state">
          <children>
            <VBox alignment="CENTER" maxWidth="520.0" spacing="14.0" styleClass="welcome-empty-panel">
              <children>
                <Label styleClass="welcome-empty-badge" text="学生交流社区" />
                <Label styleClass="welcome-empty-title" text="欢迎回来" />
                <Label styleClass="welcome-empty-subtitle" text="从左侧菜单进入个人中心、帖子广场或系统管理，开始今天的校园交流与内容管理。" wrapText="true" />
                <Region prefHeight="8.0" />
                <Label styleClass="welcome-empty-hint" text="当前还没有打开标签页" />
              </children>
            </VBox>
          </children>
        </StackPane>
      </children>
    </StackPane>
  </center>
  <bottom>
    <HBox id="HBox" alignment="CENTER_LEFT" spacing="5.0" styleClass="app-status-bar">
      <children>
        <Label maxHeight="1.7976931348623157E308" maxWidth="-1.0" text="Left status" HBox.hgrow="ALWAYS" fx:id="systemPrompt" >
          <font>
            <Font size="11.0" fx:id="x3" />
          </font>
          <textFill >
            <Color red="0.625" green="0.625" blue="0.625" fx:id="x4" />
          </textFill>
        </Label>
        <Pane prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER_LEFT" spacing="5.0">
          <children>
            <Label fx:id="unreadNotificationLabel" font="$x3" style="-fx-text-fill: red; -fx-cursor: hand;" text="" HBox.hgrow="NEVER" />
            <Label font="$x3" maxWidth="-1.0" text="Right status" textFill="$x4" HBox.hgrow="NEVER" />
          </children>
        </HBox>
      </children>
      <padding>
        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
      </padding>
    </HBox>
  </bottom>
</BorderPane>
