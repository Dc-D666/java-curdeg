<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.teach.javafx.controller.MyPostsController" styleClass="data-root" stylesheets="@css/personal-center.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="data-toolbar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18.0" left="22.0" right="22.0" top="22.0"/>
            </padding>
            <children>
                <Label styleClass="section-title" text="我的帖子"/>
                <Label fx:id="totalLabel" styleClass="profile-subtitle" text=""/>
                <Button fx:id="refreshButton" mnemonicParsing="false" styleClass="btn-secondary" text="刷新" />
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="mainScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="profile-scroll-pane" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="18.0" styleClass="profile-page">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="0.0"/>
                    </padding>
                    <children>
                        <VBox fx:id="postListVBox" spacing="12.0"/>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="18.0" styleClass="pagination-bar" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="prevButton" mnemonicParsing="false" styleClass="pagination-button" text="上一页"/>
                <Label fx:id="pageInfoLabel" styleClass="pagination-info" text="共 0 条，第 1 / 1 页"/>
                <Button fx:id="nextButton" mnemonicParsing="false" styleClass="pagination-button" text="下一页"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
