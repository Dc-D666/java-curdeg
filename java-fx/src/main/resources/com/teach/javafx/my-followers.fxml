<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.teach.javafx.controller.MyFollowersController" styleClass="following-root" stylesheets="@css/personal-center.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="following-scroll">
            <content>
                <VBox spacing="18.0" styleClass="following-page">
                    <padding>
                        <Insets bottom="22.0" left="26.0" right="26.0" top="22.0"/>
                    </padding>
                    <children>
                        <VBox spacing="8.0" styleClass="following-hero">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="following-hero-title" text="我的粉丝"/>
                                        <Label styleClass="following-title-mark" text="❖"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="followerRefreshButton" mnemonicParsing="false" styleClass="following-refresh-button" text="刷新"/>
                                    </children>
                                </HBox>
                                <Label styleClass="following-hero-hint" text="双击头像或昵称可进入对方主页，点击右侧按钮可关注或取消关注"/>
                            </children>
                        </VBox>

                        <VBox spacing="14.0" styleClass="following-section">
                            <children>
                                <Label styleClass="following-section-title" text="粉丝概览"/>
                                <GridPane hgap="14.0" vgap="14.0">
                                    <children>
                                        <VBox styleClass="following-stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="following-stat-title" text="粉丝总数"/>
                                                <Label fx:id="followerTotalValueLabel" styleClass="following-stat-value" text="0 人"/>
                                            </children>
                                        </VBox>
                                        <VBox styleClass="following-stat-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="following-stat-title" text="本周新增粉丝"/>
                                                <Label fx:id="followerWeekValueLabel" styleClass="following-stat-value" text="0 人"/>
                                            </children>
                                        </VBox>
                                        <VBox styleClass="following-stat-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="following-stat-title" text="互动最频繁"/>
                                                <Label fx:id="followerTopUserValueLabel" styleClass="following-stat-value" text="暂无"/>
                                            </children>
                                        </VBox>
                                        <VBox styleClass="following-stat-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="following-stat-title" text="活跃用户占比"/>
                                                <Label fx:id="followerActiveRateValueLabel" styleClass="following-stat-value" text="0%"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                        <VBox spacing="14.0" styleClass="following-section">
                            <children>
                                <Label styleClass="following-section-title" text="粉丝列表"/>
                                <VBox fx:id="followerCardList" spacing="12.0"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="18.0" styleClass="following-pagination-bar">
            <children>
                <Button fx:id="followerPrevButton" mnemonicParsing="false" styleClass="pagination-button" text="上一页"/>
                <Label fx:id="followerPageInfoLabel" styleClass="pagination-info" text="共 0 条，第 1 / 1 页"/>
                <Button fx:id="followerNextButton" mnemonicParsing="false" styleClass="pagination-button" text="下一页"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
