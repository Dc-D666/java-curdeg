<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.teach.javafx.controller.PointHistoryController"
      spacing="14" styleClass="profile-page" stylesheets="@css/personal-center.css">
    <padding>
        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0"/>
    </padding>
    <Label text="山竹瓣明细" styleClass="section-title"/>
    <TableView fx:id="pointTable" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn text="时间" fx:id="timeColumn" prefWidth="150"/>
            <TableColumn text="行为" fx:id="actionColumn" prefWidth="200"/>
            <TableColumn text="变动" fx:id="changeColumn" prefWidth="100"/>
            <TableColumn text="余额" fx:id="balanceColumn" prefWidth="100"/>
        </columns>
    </TableView>
    <HBox alignment="CENTER" spacing="18.0" styleClass="pagination-bar">
        <children>
            <Button fx:id="prevButton" mnemonicParsing="false" styleClass="pagination-button" text="上一页"/>
            <Label fx:id="pageInfoLabel" styleClass="pagination-info" text="共 0 条，第 1 / 1 页"/>
            <Button fx:id="nextButton" mnemonicParsing="false" styleClass="pagination-button" text="下一页"/>
        </children>
    </HBox>
</VBox>
