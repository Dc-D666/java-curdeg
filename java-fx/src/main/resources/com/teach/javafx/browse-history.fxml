<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.teach.javafx.controller.BrowseHistoryController" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
                <children>
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="浏览历史"/>
                    <Label fx:id="totalLabel" style="-fx-text-fill: white;" text=""/>
                    <Button fx:id="refreshButton" mnemonicParsing="false" text="刷新" />
                    <Button fx:id="clearButton" mnemonicParsing="false" text="清空历史" style="-fx-background-color: #ef4444; -fx-text-fill: white;" />
                </children>
            </HBox>
            <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10; -fx-background-color: #f3f4f6;">
                <children>
                    <Button fx:id="prevButton" mnemonicParsing="false" text="上一页" style="-fx-background-color: #6366f1; -fx-text-fill: white;" />
                    <Label fx:id="pageLabel" style="-fx-font-size: 14; -fx-text-fill: #374151;" text="第 1 / 1 页"/>
                    <Button fx:id="nextButton" mnemonicParsing="false" text="下一页" style="-fx-background-color: #6366f1; -fx-text-fill: white;" />
                </children>
            </HBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="mainScrollPane" fitToWidth="true" BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="historyListVBox" spacing="10" style="-fx-padding: 10;">
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
