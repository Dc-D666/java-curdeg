<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.teach.javafx.controller.BrowseHistoryController" styleClass="data-root" stylesheets="@css/personal-center.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="8.0" styleClass="data-toolbar" BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <padding>
                    <Insets bottom="4.0" left="0.0" right="0.0" top="0.0"/>
                </padding>
                <children>
                    <Label styleClass="section-title" text="浏览历史"/>
                    <Label fx:id="totalLabel" styleClass="profile-subtitle" text=""/>
                    <Button fx:id="refreshButton" mnemonicParsing="false" styleClass="btn-secondary" text="刷新" />
                    <Button fx:id="clearButton" mnemonicParsing="false" styleClass="danger-button" text="清空历史" />
                </children>
            </HBox>
            <padding>
                <Insets bottom="18.0" left="22.0" right="22.0" top="22.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="mainScrollPane" fitToWidth="true" styleClass="profile-scroll-pane" BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="historyListVBox" spacing="10" styleClass="profile-page">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="0.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="18.0" styleClass="pagination-bar" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="prevButton" mnemonicParsing="false" styleClass="pagination-button" text="上一页" />
                <Label fx:id="pageLabel" styleClass="pagination-info" text="共 0 条，第 1 / 1 页"/>
                <Button fx:id="nextButton" mnemonicParsing="false" styleClass="pagination-button" text="下一页" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
