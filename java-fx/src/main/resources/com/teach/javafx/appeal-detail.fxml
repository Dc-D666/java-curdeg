<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.AppealDetailController" style="-fx-background-color: white;">
    <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 20;">
        <VBox spacing="10">
            <Label text="申诉信息" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
            <VBox spacing="8" style="-fx-background-color: #f5f5f5; -fx-background-radius: 8; -fx-padding: 15;">
                <HBox spacing="10">
                    <Label text="申诉ID：" style="-fx-font-size: 14px; -fx-text-fill: #333333;" />
                    <Label fx:id="appealIdLabel" style="-fx-font-size: 14px; -fx-text-fill: #333333;" text="--" />
                </HBox>
                <HBox spacing="10">
                    <Label text="提交时间：" style="-fx-font-size: 14px; -fx-text-fill: #333333;" />
                    <Label fx:id="createTimeLabel" style="-fx-font-size: 14px; -fx-text-fill: #333333;" text="--" />
                </HBox>
                <HBox spacing="10">
                    <Label text="申诉状态：" style="-fx-font-size: 14px; -fx-text-fill: #333333;" />
                    <Label fx:id="statusLabel" style="-fx-font-size: 14px; -fx-text-fill: #333333;" text="--" />
                </HBox>
            </VBox>
        </VBox>
        
        <VBox spacing="10">
            <Label text="用户信息" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
            <VBox spacing="8" style="-fx-background-color: #f5f5f5; -fx-background-radius: 8; -fx-padding: 15;">
                <HBox spacing="10">
                    <Label text="用户名：" style="-fx-font-size: 14px; -fx-text-fill: #333333;" />
                    <Label fx:id="userNameLabel" style="-fx-font-size: 14px; -fx-text-fill: #333333;" text="--" />
                </HBox>
                <HBox spacing="10">
                    <Label text="学号：" style="-fx-font-size: 14px; -fx-text-fill: #333333;" />
                    <Label fx:id="studentIdLabel" style="-fx-font-size: 14px; -fx-text-fill: #333333;" text="--" />
                </HBox>
                <HBox spacing="10">
                    <Label text="账号状态：" style="-fx-font-size: 14px; -fx-text-fill: #333333;" />
                    <Label fx:id="bannedStatusLabel" style="-fx-font-size: 14px; -fx-text-fill: #333333;" text="--" />
                </HBox>
            </VBox>
        </VBox>
        
        <VBox spacing="10">
            <Label text="申诉理由" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
            <VBox spacing="8" style="-fx-background-color: #f5f5f5; -fx-background-radius: 8; -fx-padding: 15;">
                <TextArea fx:id="reasonArea" editable="false" prefHeight="120" wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #333333; -fx-control-inner-background: white;" />
            </VBox>
        </VBox>
        
        <VBox spacing="10" fx:id="resultSection" visible="false">
            <Label text="处理结果" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
            <VBox spacing="8" style="-fx-background-color: #f5f5f5; -fx-background-radius: 8; -fx-padding: 15;">
                <HBox spacing="10">
                    <Label text="处理时间：" style="-fx-font-size: 14px; -fx-text-fill: #333333;" />
                    <Label fx:id="handleTimeLabel" style="-fx-font-size: 14px; -fx-text-fill: #333333;" text="--" />
                </HBox>
                <HBox spacing="10">
                    <Label text="处理结果：" style="-fx-font-size: 14px; -fx-text-fill: #333333;" />
                    <Label fx:id="handleResultLabel" style="-fx-font-size: 14px; -fx-text-fill: #333333;" text="--" />
                </HBox>
            </VBox>
        </VBox>
        
        <HBox spacing="15" fx:id="actionButtonsBox" style="-fx-padding: 10 0 0 0;" alignment="CENTER_LEFT">
            <Button fx:id="approveButton" onAction="#onApproveClick" text="通过申诉" style="-fx-font-size: 14px; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" />
            <Button fx:id="rejectButton" onAction="#onRejectClick" text="驳回申诉" style="-fx-font-size: 14px; -fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" />
            <Button onAction="#onBackClick" text="返回" style="-fx-font-size: 14px; -fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" />
        </HBox>
    </VBox>
</ScrollPane>
