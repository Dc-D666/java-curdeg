<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.ComboBox?>
<BorderPane styleClass="data-root" stylesheets="@css/personal-center.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.ScoreTableController">
   <top>
       <HBox id="HBox" alignment="CENTER_LEFT" spacing="12.0" styleClass="data-toolbar">
           <children>
               <FlowPane alignment="CENTER_LEFT" hgap="8.0" prefHeight="40.0" prefWidth="240.0" BorderPane.alignment="CENTER">
                   <children>
                       <Button mnemonicParsing="false" onAction="#onAddButtonClick" styleClass="primary-button" text="添加">
                           <FlowPane.margin>
                               <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </FlowPane.margin>
                       </Button>
                       <Button mnemonicParsing="false" onAction="#onEditButtonClick" styleClass="secondary-button" text="修改">
                           <FlowPane.margin>
                               <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </FlowPane.margin>
                       </Button>
                       <Button mnemonicParsing="false" onAction="#onDeleteButtonClick" styleClass="danger-button" text="删除">
                           <FlowPane.margin>
                               <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </FlowPane.margin>
                       </Button>
                   </children>
               </FlowPane>
               <Pane prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
               <FlowPane alignment="CENTER_RIGHT" hgap="8.0" prefHeight="40.0" prefWidth="560.0" BorderPane.alignment="CENTER">
                   <children>
                       <Label styleClass="data-filter-label" text="学生"  >
                           <FlowPane.margin>
                               <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </FlowPane.margin>
                       </Label>
                       <ComboBox fx:id="studentComboBox" prefWidth="150.0" >
                           <FlowPane.margin>
                               <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </FlowPane.margin>
                       </ComboBox>
                       <Label styleClass="data-filter-label" text="课程"  >
                           <FlowPane.margin>
                               <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </FlowPane.margin>
                       </Label>
                       <ComboBox fx:id="courseComboBox" prefWidth="150.0" >
                           <FlowPane.margin>
                               <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </FlowPane.margin>
                       </ComboBox>
                       <Button mnemonicParsing="false" onAction="#onQueryButtonClick" styleClass="primary-button" text="查询">
                           <FlowPane.margin>
                               <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </FlowPane.margin>
                       </Button>
                   </children>
               </FlowPane>
           </children>
           <padding>
               <Insets bottom="18.0" left="22.0" right="22.0" top="22.0" />
           </padding>
       </HBox>
   </top>
   <center>
        <TableView fx:id="dataTableView" styleClass="data-table" BorderPane.alignment="CENTER" >
            <BorderPane.margin>
                <Insets bottom="22.0" left="22.0" right="22.0" top="0.0" />
            </BorderPane.margin>
            <columns>
                <TableColumn fx:id="studentNumColumn" prefWidth="120.0" text="学号" />
                <TableColumn fx:id="studentNameColumn" prefWidth="90.0" text="姓名" />
                <TableColumn fx:id="classNameColumn" prefWidth="140.0" text="班级" />
                <TableColumn fx:id="courseNumColumn" prefWidth="120.0" text="课程号" />
                <TableColumn fx:id="courseNameColumn" prefWidth="140.0" text="课程名" />
                <TableColumn fx:id="creditColumn" prefWidth="60.0" text="学分" />
                <TableColumn fx:id="markColumn" prefWidth="60.0" text="成绩" />
                <TableColumn fx:id="editColumn" prefWidth="60.0" text="操作" />
            </columns>
        </TableView>
   </center>
</BorderPane>
