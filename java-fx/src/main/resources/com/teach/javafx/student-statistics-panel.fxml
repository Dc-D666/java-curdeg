<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<BorderPane styleClass="data-root" stylesheets="@css/personal-center.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" prefWidth="800.0"
            fx:controller="com.teach.javafx.controller.StudentStatisticsController">
    <top>
        <HBox id="HBox" alignment="CENTER_LEFT" spacing="12.0" styleClass="data-toolbar">
            <padding>
                <Insets bottom="18.0" left="22.0" right="22.0" top="22.0"/>
            </padding>
            <FlowPane prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            </FlowPane>
            <Pane HBox.hgrow="ALWAYS"/>
            <FlowPane alignment="CENTER_RIGHT" hgap="8.0" prefHeight="40.0" prefWidth="400.0" BorderPane.alignment="CENTER">
                <Button mnemonicParsing="false" onAction="#onStatisticsButtonClick" styleClass="primary-button" text="统计">
                    <FlowPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </FlowPane.margin>
                </Button>
                <Button mnemonicParsing="false" onAction="#onQueryButtonClick" styleClass="btn-secondary" text="查询">
                    <FlowPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </FlowPane.margin>
                </Button>
            </FlowPane>
        </HBox>
    </top>
    <center>
        <TableView fx:id="dataTableView" styleClass="data-table">
            <BorderPane.margin>
                <Insets bottom="22.0" left="22.0" right="22.0" top="0.0"/>
            </BorderPane.margin>
            <columns>
                <TableColumn fx:id="studentNumColumn" prefWidth="100.0" text="学号"/>
                <TableColumn fx:id="studentNameColumn" prefWidth="70.0" text="姓名"/>
                <TableColumn fx:id="courseCountColumn" prefWidth="70.0" text="课程数"/>
                <TableColumn fx:id="avgScoreColumn" prefWidth="70.0" text="平均成绩"/>
                <TableColumn fx:id="gpaColumn" prefWidth="70.0" text="GPA"/>
                <TableColumn fx:id="noColumn" prefWidth="70.0" text="排名"/>
                <TableColumn fx:id="leaveCountColumn" prefWidth="70.0" text="请假次数"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
