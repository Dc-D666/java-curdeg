<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.teach.javafx.controller.MemberManagementController" styleClass="data-root" stylesheets="@css/personal-center.css,@css/bbs-comments.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="data-toolbar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18" left="22" right="22" top="22" />
            </padding>
            <children>
                <Label text="成员管理" styleClass="section-title" />
                <TextField fx:id="searchField" prefWidth="250" promptText="搜索用户名或昵称" />
                <Button fx:id="searchButton" text="搜索" styleClass="primary-button" />
                <Button fx:id="refreshButton" text="刷新" styleClass="btn-secondary" />
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="12" styleClass="profile-page">
            <padding>
                <Insets bottom="22.0" left="22.0" right="22.0" top="0.0" />
            </padding>
            <TableView fx:id="userTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="80" text="用户ID" />
                    <TableColumn fx:id="usernameColumn" prefWidth="150" text="用户名" />
                    <TableColumn fx:id="nicknameColumn" prefWidth="150" text="昵称" />
                    <TableColumn fx:id="roleColumn" prefWidth="120" text="角色" />
                    <TableColumn fx:id="bannedColumn" prefWidth="80" text="是否禁言" />
                    <TableColumn fx:id="actionColumn" prefWidth="280" text="操作" />
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="18" styleClass="pagination-bar" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="prevPageButton" text="上一页" styleClass="pagination-button" />
                <Label fx:id="pageInfoLabel" text="共 0 条，第 1 / 1 页" styleClass="pagination-info" />
                <Button fx:id="nextPageButton" text="下一页" styleClass="pagination-button" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
